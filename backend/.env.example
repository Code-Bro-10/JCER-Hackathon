# ========================================================
# TrafficAI Smart City Backend Environment Configuration
# ========================================================

# Server Port
PORT=8000

# Environment Mode (development | production | test)
NODE_ENV=development

# Allowed Frontend Client Origin for CORS and Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas URI or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/trafficai?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/trafficai
MONGODB_URI=mongodb://127.0.0.1:27017/trafficai

# JWT Authentication Secrets
JWT_SECRET=trafficai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Auto-seed initial traffic dataset on server startup if collections are empty
ENABLE_SEED_ON_STARTUP=true

# Logging Level
LOG_LEVEL=info

